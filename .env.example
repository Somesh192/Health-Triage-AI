# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
APP_NAME=Health Triage AI
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

# ===========================================
# BACKEND CONFIGURATION (FastAPI)
# ===========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# ===========================================
# FRONTEND CONFIGURATION (Next.js)
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# SQLite (Development)
DATABASE_URL=sqlite:///./health_triage.db

# PostgreSQL (Production)
# DATABASE_URL=postgresql://user:password@localhost:5432/health_triage

# ===========================================
# AUTHENTICATION CONFIGURATION
# ===========================================
# JWT Secret Key - Generate a strong random string
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Password Hashing
PASSLIB_CONTEXT=bcrypt

# ===========================================
# OLLAMA CONFIGURATION (Local LLM)
# ===========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=300

# ===========================================
# GEMINI API CONFIGURATION (Cloud LLM)
# ===========================================
# Get API key from: https://makersuite.google.com/app/apikey
# Used for AI Chat feature (patient health queries)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2000

# ===========================================
# BHASHINI API CONFIGURATION (Speech-to-Text)
# ===========================================
# Get credentials from: https://bhashini.gov.in/
BHASHINI_API_URL=https://your-bhashini-url
BHASHINI_API_KEY=your-bhashini-api-key-here
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_WORKER_ID=your-bhashini-worker-id

# ===========================================
# GOOGLE TRANSLATION API (Optional)
# ===========================================
# Get API key from: https://cloud.google.com/translate
GOOGLE_TRANSLATION_API_KEY=your-google-translation-api-key-here

# ===========================================
# OCR CONFIGURATION
# ===========================================
# PaddleOCR Configuration
PADDLEOCR_USE_GPU=false
PADDLEOCR_LANG=en
PADDLEOCR_DET_MODEL_DIR=./models/ocr/det
PADDLEOCR_REC_MODEL_DIR=./models/ocr/rec

# Tesseract Configuration (Fallback)
TESSERACT_PATH=/usr/bin/tesseract  # Linux
# TESSERACT_PATH=C:\\Program Files\\Tesseract-OCR\\tesseract.exe  # Windows

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png
UPLOAD_DIR=./uploads
TEMP_DIR=./temp

# ===========================================
# PRIVACY CONFIGURATION
# ===========================================
# Data Retention (days)
DATA_RETENTION_DAYS=30

# PII Anonymization
PII_DETECTION_ENABLED=true
PII_REDACTION_ENABLED=true

# Consent Recording
CONSENT_AUDIO_ENABLED=true
CONSENT_VIDEO_ENABLED=false

# ===========================================
# AUDIT LOGGING CONFIGURATION
# ===========================================
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FILE=./logs/audit.log
AUDIT_LOG_LEVEL=INFO

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ===========================================
# OFFLINE CONFIGURATION
# ===========================================
OFFLINE_MODE_ENABLED=true
OFFLINE_SYNC_ENABLED=true
OFFLINE_SYNC_INTERVAL_SECONDS=300

# ===========================================
# FEATURE FLAGS
# ===========================================
# Enable/Disable features for testing
FEATURE_VOICE_INPUT=true
FEATURE_OCR_PROCESSING=true
FEATURE_LLM_SUMMARIZATION=true
FEATURE_RULE_ENGINE=true
FEATURE_DASHBOARD=true
FEATURE_REFERRAL_GENERATION=true
FEATURE_OFFLINE_MODE=true

# ===========================================
# MONITORING CONFIGURATION
# ===========================================
# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=development

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=false

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================
# Mock APIs for testing without real API keys
USE_MOCK_APIS=false
MOCK_VOICE_RESPONSE=true
MOCK_LLM_RESPONSE=true
MOCK_OCR_RESPONSE=true

# ===========================================
# PRODUCTION CONFIGURATION (Uncomment for Production)
# ===========================================
# APP_ENV=production
# DEBUG=false
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# JWT_SECRET=your-production-secret-key
# CORS_ORIGINS=https://your-domain.com
# LOG_LEVEL=WARNING
# USE_MOCK_APIS=false

# ===========================================
# ABDM CONFIGURATION (Future Integration)
# ===========================================
# ABDM_API_URL=https://abdm.gov.in/api
# ABDM_CLIENT_ID=your-abdm-client-id
# ABDM_CLIENT_SECRET=your-abdm-client-secret
# ABDM_ENV=sandbox

# ===========================================
# TESTING CONFIGURATION
# ===========================================
TEST_DATABASE_URL=sqlite:///./test_health_triage.db
TEST_MODE=false
